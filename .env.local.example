# The only secret the app needs to run.
# z.ai (GLM) key — get one at https://z.ai. Server-funded scoring runs on the
# free glm-4.5-flash model, so this key costs ~$0 in inference.
GLM_API_KEY=

# Digistories funnel — where /go and the post-score CTA send visitors.
NEXT_PUBLIC_DIGISTORIES_URL=https://www.digistories.cc

# Optional: users can bring their own OpenAI-compatible key via the in-app
# Settings drawer (BYOK). No server env is needed for that path.
